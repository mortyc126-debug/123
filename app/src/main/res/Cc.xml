<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:text="0x7f110043"
            style="0x7f120049"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="0x7f090391"
            android:background="@+id/design_menu_item_action_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp">
            <androidx.appcompat.widget.SearchView
                android:id="0x7f0903ed"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:maxLines="1"
                android:completionThreshold="2"
                android:layout_toLeftOf="0x7f0900fb"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:imeOptions="flagNoExtractUi|actionSearch"
                app:defaultQueryHint="0x7f1103d9"
                app:iconifiedByDefault="false"
                app:queryBackground="@dimen/m3_comp_slider_active_handle_leading_space"
                app:searchIcon="@null"/>
            <android.widget.Button
                android:ellipsize="end"
                android:id="0x7f0900fb"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="4dp"
                android:text="0x7f1101d4"
                android:maxLines="1"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="0x7f120037"/>
        </RelativeLayout>
        <TextView
            android:textColor="#f65448"
            android:id="0x7f0901c9"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            style="0x7f12009b"/>
        <android.widget.Button
            android:textSize="14sp"
            android:gravity="center"
            android:id="0x7f0900fd"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="0x7f110041"
            style="0x7f120037"/>
    </LinearLayout>
</RelativeLayout>
