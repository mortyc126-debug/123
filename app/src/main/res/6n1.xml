<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true"
        android:color="@dimen/m3_comp_slider_disabled_inactive_track_opacity">
        <shape>
            <solid android:color="@dimen/m3_comp_navigation_rail_focus_state_layer_opacity"/>
            <stroke
                android:width="1dp"
                android:color="@dimen/m3_comp_slider_disabled_inactive_track_opacity"/>
            <corners android:radius="4dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
    <item android:color="@dimen/m3_comp_navigation_rail_focus_state_layer_opacity">
        <shape>
            <solid android:color="@dimen/m3_comp_slider_disabled_inactive_track_opacity"/>
            <stroke
                android:width="1dp"
                android:color="@dimen/m3_comp_navigation_rail_focus_state_layer_opacity"/>
            <corners android:radius="4dp"/>
            <padding
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp"/>
        </shape>
    </item>
</selector>
