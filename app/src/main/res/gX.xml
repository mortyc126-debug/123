<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="0x7f090299"
        android:layout_width="328dp"
        android:layout_height="200dp">
        <ImageView
            android:id="0x7f090253"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <FrameLayout
            android:id="0x7f0901b0"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@dimen/m3_comp_navigation_rail_container_width">
            <ImageView
                android:id="0x7f0901af"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@dimen/abc_panel_menu_list_width"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:tint="@dimen/m3_comp_radio_button_unselected_hover_state_layer_opacity"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@+id/material_value_index"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:id="0x7f0901a4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="11dp"
        android:maxWidth="320dp"
        android:lines="1"
        android:layout_below="0x7f090299"
        style="0x7f12008c"/>
</RelativeLayout>
