<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#ff292929"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ff292929"
        android:layout_width="match_parent"
        android:layout_height="35dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="75dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <ImageView
            android:id="@+id/noneticon"
            android:paddingLeft="5dp"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:src="@drawable/r_f5bsi0"
            android:layout_weight="0.4"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#fff8f8f8"
            android:gravity="top|center_horizontal"
            android:id="@+id/nodescrip"
            android:paddingTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:text="No internet connection detected.\10\10 please connect to internet and try again"
            android:shadowRadius="2"
            android:fontFamily="sans-serif"/>
        <Button
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#ff000000"
            android:layout_gravity="center"
            android:id="@+id/closeme"
            android:background="@drawable/r_6u53zn"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:shadowRadius="2"/>
    </LinearLayout>
</LinearLayout>
